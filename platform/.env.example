# Copy to .env.local for development. Never commit real secrets —
# production values come from SSM Parameter Store / Secrets Manager.

DATABASE_URL=postgres://baltic:baltic@localhost:5432/baltic_bridge

# Auth.js
AUTH_SECRET=dev-only-change-me
AUTH_URL=http://localhost:3000

# S3 (MinIO in dev; real S3 in eu-north-1 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-north-1
S3_ACCESS_KEY_ID=baltic
S3_SECRET_ACCESS_KEY=baltic-secret
S3_DOCUMENTS_BUCKET=documents
S3_FORCE_PATH_STYLE=true

# Email (dev logs magic links / notifications instead of sending)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@piotrr.com

# Malware scanning: 'noop' in dev, 'clamav' in the self-hosted stack
MALWARE_SCANNER=noop
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
