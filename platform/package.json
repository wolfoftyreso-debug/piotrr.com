{
  "name": "piotrr",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-demo": "tsx src/db/seed-demo.ts",
    "sandbox": "docker compose up -d && npm run db:migrate && SEED_STAFF_PASSWORD=change-me-now npm run db:seed && npm run db:seed-demo && npm run db:seed-catalog && next dev",
    "db:seed-catalog": "tsx src/db/seed-catalog.ts",
    "test:flow": "tsx src/db/flow-test.ts",
    "test:smoke": "tsx src/db/smoke.ts",
    "test:http": "bash scripts/audit-http.sh",
    "test:security": "tsx src/db/security-test.ts",
    "test:failure": "tsx src/db/failure-test.ts",
    "test:contract": "tsx scripts/contract-check.ts",
    "test:load": "node scripts/load-test.mjs",
    "verify": "bash scripts/health-check.sh",
    "verify:full": "bash scripts/health-check.sh --full"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "next-intl": "^4.13.5",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
