# Template for the self-hosted stack (docker-compose.selfhost.yml).
# Copy to .env.selfhost and fill in real values. NEVER commit .env.selfhost.

POSTGRES_USER=baltic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baltic_bridge

# The app refuses to run in production against an unverified database
# connection. This compose stack keeps app↔db traffic on one host's docker
# bridge and issues no database certificate, so it is accepted here
# deliberately; the process says so on every boot. The k8s path does issue
# one (infra/k8s/pg-tls.sh) and runs with this set to false.
DATABASE_ALLOW_PLAINTEXT=true

MINIO_ROOT_USER=baltic
MINIO_ROOT_PASSWORD=change-me
S3_DOCUMENTS_BUCKET=documents
# URL browsers use to reach MinIO (presigned URLs are signed against it),
# e.g. https://files.piotrr.example — proxied to minio:9000.
S3_ENDPOINT=https://files.example.com
S3_REGION=eu-north-1

# openssl rand -base64 32
AUTH_SECRET=
CRON_SECRET=

PUBLIC_BASE_URL=https://www.example.com

# Only needed with the Caddy TLS front (docker-compose.proxy.yml)
APP_DOMAIN=www.example.com
FILES_DOMAIN=files.example.com
ACME_EMAIL=ops@example.com

# Own relay (Postfix container / org smarthost). Use EMAIL_PROVIDER=console
# to disable outbound mail entirely.
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.com
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Malware scanning of uploaded evidence. 'clamav' talks to the clamav
# service in docker-compose.selfhost.yml; 'noop' disables scanning and is
# only for local development.
MALWARE_SCANNER=clamav
